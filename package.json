{
  "name": "bechdel-test-for-movie-sites",
  "version": "2.0.1",
  "private": true,
  "description": "Chrome extension that shows Bechdel Test scores on movie catalogs and adds ratings and filters to bechdeltest.com",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.ts",
    "watch": "node build.ts --watch",
    "zip": "node build.ts --zip",
    "check": "tsc",
    "test": "vitest run",
    "preversion": "npm run check && npm test"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
